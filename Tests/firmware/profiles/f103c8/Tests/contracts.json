{
  "schema": 1,
  "contracts": {
    "ci_gpio_macros": {
      "macros": {
        "context": "board_led_toggle",
        "expressions": [
          "RCC",
          "RCC_APB2ENR_IOPCEN",
          "GPIOC",
          "GPIO_CRH_MODE13",
          "GPIO_CRH_MODE13_1",
          "GPIO_CRH_CNF13"
        ]
      }
    },
    "ci_app_api": {
      "type_context": "app_step",
      "functions": {
        "app_step": {
          "returns": "uint32_t",
          "arguments": [
            {
              "name": "state",
              "type": "app_state_t *"
            },
            {
              "name": "mode",
              "type": "app_mode_t"
            }
          ]
        },
        "app_loop": {
          "returns": "void",
          "arguments": []
        }
      },
      "fields": {
        "app_state_t": {
          "ticks": "uint32_t",
          "led": "uint8_t"
        }
      },
      "enums": {
        "app_mode_t": {
          "APP_MODE_IDLE": 0,
          "APP_MODE_BLINK": 1
        }
      }
    }
  }
}
