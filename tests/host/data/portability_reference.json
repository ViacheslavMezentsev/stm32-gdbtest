        "-noir",
        "-noreset",
        "-nohalt",
        "-nosinglerun",
        "-vd",
        "-log",
        "/out/jlink.log"
      ],
      "finish": [
        "monitor reset",
        "monitor go",
        "disconnect"
      ],
      "ready": "Waiting for GDB connection",
      "reset_halt": "monitor reset",
      "setup": [
        "monitor flash breakpoints = 0"
      ]
    },
