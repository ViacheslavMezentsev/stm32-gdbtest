        "-c",
        "bindto 127.0.0.1",
        "-c",
        "gdb_port 61000",
        "-c",
        "tcl_port disabled",
        "-c",
        "telnet_port disabled"
      ],
      "finish": [
        "monitor reset run",
        "disconnect"
      ],
