# GNU Arm toolchain from ARM_TOOLCHAIN_ROOT (cache or environment); Windows adds .exe.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(DEFINED ENV{ARM_TOOLCHAIN_ROOT})
    set(arm_toolchain_default "$ENV{ARM_TOOLCHAIN_ROOT}")
elseif(CMAKE_HOST_WIN32)
    set(arm_toolchain_default "$ENV{USERPROFILE}/xpack-arm-none-eabi-gcc-13.3.1-1.1")
else()
    set(arm_toolchain_default "/opt/xpack-arm-none-eabi-gcc-13.3.1-1.1")
endif()
set(ARM_TOOLCHAIN_ROOT "${arm_toolchain_default}" CACHE PATH "ARM GCC installation")
if(CMAKE_HOST_WIN32)
    set(CMAKE_C_COMPILER "${ARM_TOOLCHAIN_ROOT}/bin/arm-none-eabi-gcc.exe")
else()
    set(CMAKE_C_COMPILER "${ARM_TOOLCHAIN_ROOT}/bin/arm-none-eabi-gcc")
endif()

get_filename_component(arm_bin "${CMAKE_C_COMPILER}" DIRECTORY)
if(CMAKE_HOST_WIN32)
    set(arm_suffix .exe)
endif()
set(CMAKE_CXX_COMPILER "${arm_bin}/arm-none-eabi-g++${arm_suffix}")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
